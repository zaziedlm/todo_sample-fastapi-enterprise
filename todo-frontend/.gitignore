# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Turbopack cache
.turbo/

# Package manager lock files (choose one approach)
# Option 1: Keep package-lock.json for npm
# Option 2: Uncomment below if using yarn/pnpm exclusively
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Build artifacts
/dist/
*.tgz

# Runtime data
pids/
*.pid
*.seed

# Coverage directory used by tools like istanbul
lib-cov/

# Dependency directories for monorepos
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# ESLint cache
.eslintcache

# Stylelint cache
.stylelintcache

# Prettier cache (if using)
.prettiercache

# Temporary folders
tmp/
temp/
